BOT_TOKEN=your-telegram-bot-token
# Local/VPS DB DSN example (Docker network "db")
DB_DSN=postgresql+asyncpg://tbot:tbot@db:5432/tbot
# Railway injects DATABASE_URL automatically from managed Postgres.
# Leave it unset in Railway project variables unless you need a manual override.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
ADMIN_IDS=123456789
REMIND_BEFORE_MIN=60
TZ=Europe/Moscow

WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Railway injects PORT automatically for public services.
# PORT=8080
WEB_PUBLIC_URL=https://your-app.up.railway.app
WEB_INIT_DATA_MAX_AGE_SEC=86400
WEB_DEV_AUTH_BYPASS=false
WEB_DEV_USER_ID=
WEB_DEV_USER_USERNAME=

# Only for VPS + Caddy deployment.
DOMAIN=example.ru
